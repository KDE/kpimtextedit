include($KDE_DOCS/global/qt-module-defaults.qdocconf)

project = KPIMTextedit
moduleheader = kpimtextedit_qdocmoduleheader.h
description = KPIMTextedit provides a textedit with PIM-specific features.

documentationinheaders = true

headers += \
    composer-ng/richtextcomposer.h \
    composer-ng/richtextcomposeractions.h \
    composer-ng/richtextcomposercontroler.h \
    composer-ng/richtextcomposeremailquotehighlighter.h \
    composer-ng/richtextcomposerimages.h \
    composer-ng/richtextcomposerwidget.h \
    composer-ng/richtextexternalcomposer.h \
    grantleebuilder/abstractmarkupbuilder.h \
    grantleebuilder/markupdirector.h \
    grantleebuilder/plaintextmarkupbuilder.h \
    grantleebuilder/texthtmlbuilder.h \
    kpimtextedit_qdocmoduleheader.h \
    textutils.h
sourcedirs += .

excludedirs += \
    autotests \
    composer-ng/autotests \
    composer-ng/tests \
    grantleebuilder/autotests \
    tests

outputformats = HTML

depends += \
    qtcore \
    qtgui \
    qtwidgets

navigation.landingpage = "KPIMTextedit"

qhp.projects            = KPIMTextedit

qhp.KPIMTextedit.file                = kpimtextedit.qhp
qhp.KPIMTextedit.namespace           = org.kde.kpimtextedit.$QT_VERSION_TAG
qhp.KPIMTextedit.virtualFolder       = kpimtextedit
qhp.KPIMTextedit.indexTitle          = KPIMTextedit
qhp.KPIMTextedit.indexRoot           =

qhp.KPIMTextedit.subprojects         = classes
qhp.KPIMTextedit.subprojects.classes.title = C++ Classes
qhp.KPIMTextedit.subprojects.classes.indexTitle = KPIMTextedit C++ Classes
qhp.KPIMTextedit.subprojects.classes.selectors = class fake:headerfile
qhp.KPIMTextedit.subprojects.classes.sortPages = true

tagfile = kpimtextedit.tags
